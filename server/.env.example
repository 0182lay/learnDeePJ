# Server Environment Variables Template
# Copy this file to '.env' and modify the values as needed for your local setup.

PORT=3003
JWT_SECRET=your_jwt_secret_key_here

# MariaDB / MySQL Configuration
# (If using Docker, these should match the configuration in docker-compose.yml)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3309
DATABASE_USER=root
DATABASE_PASSWORD=your_database_password_here
DATABASE_NAME=learndee

# Prisma Database Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"
